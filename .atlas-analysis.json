  "keyFeatures": [
    "Availability polling with specific dates or day-of-week modes",
    "Google Calendar, Outlook, and Apple Calendar integration",
    "Availability groups for real-time group scheduling",
    "Sign-up form mode for slot-based event registration",
    "Blind availability (responses hidden until event creator reveals them)",
    "Email notifications and reminders for non-respondents",
    "Max capacity per time slot with first-come-first-served logic",
    "CSV export of availability data",
    "Self-hosted premium features (no Stripe required)",
    "Docker Compose deployment with multi-platform support (amd64/arm64)",
    "Podman and systemd (Quadlet) support"
  ],
